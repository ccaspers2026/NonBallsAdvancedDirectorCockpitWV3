<Project Sdk="Microsoft.NET.Sdk">
  <!-- WV3 UI layer: the cockpit page (www HTML/JS/CSS/assets). No code. Copied to the Shell output as www\. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RootNamespace>AdvancedDirectorCockpitWV3.UI</RootNamespace>
    <AssemblyName>AdvancedDirectorCockpitWV3.UI</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="www\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
